{
  "name": "omnichat-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start -c",
    "android": "expo start --android -c",
    "ios": "expo start --ios -c",
    "postinstall": "mkdir -p node_modules/expo/node_modules && ln -sf ../../expo-asset node_modules/expo/node_modules/expo-asset && ln -sf ../../expo-font node_modules/expo/node_modules/expo-font && echo \"module.exports = require('./primitives/index');\" > node_modules/expo-router/build/primitives.js"
  },
  "dependencies": {
    "expo": "~57.0.31",
    "expo-asset": "~57.0.20",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^0.475.0",
    "query-string": "^10.0.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.4",
    "expo-module-scripts": "^56.0.3",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "socket.io-client"
        ]
      }
    }
  }
}
